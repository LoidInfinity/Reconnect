*.jsonl
# 打包的日志压缩包（含日志正文，仅供发送给支持邮箱）
NetworkGuard-logs-*.zip

# 允许提交的配置模板（不含任何真实信息）
!network_guard_config.example.json

# 运行时数据目录（配置 / 状态 / PID / 日志，源码运行时为 <repo>/data）
/data/
/logs/

# 打包版运行数据目录（%LOCALAPPDATA%\NetworkGuard）
NetworkGuard/

# 旧版本归档（含旧日志/环境，仅本地保留；注意与 tests/ 测试目录区分）
/test/

